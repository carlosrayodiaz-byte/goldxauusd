# Copia este archivo a ".env" y rellena tus datos de la cuenta DEMO de MT5.
# NUNCA subas el archivo ".env" real a git (ya esta en .gitignore).

# Credenciales de la cuenta demo (numero de cuenta, contrasena, servidor del broker)
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password_demo
MT5_SERVER=NombreDelBroker-Demo

# Opcional: ruta al ejecutable del terminal MT5 si no esta en la ubicacion
# por defecto o si tienes varios terminales instalados.
# MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Opcional: overrides de config.py
# SYMBOL=XAUUSD
# DB_PATH=data/signals.db
# LOG_PATH=logs/bot.log
# LOG_LEVEL=INFO

# --- Fase 2: capa macro (macro_engine.py), independiente de lo anterior ---
# Clave gratuita de FRED (real yields DFII10/DGS10 y calendario NFP/CPI).
# Sacarla en https://fredaccount.stlouisfed.org/apikeys (ver README).
FRED_API_KEY=tu_api_key_de_fred

# Opcional: overrides de macro_config.py
# MACRO_DB_PATH=data/macro_cache.db
# MACRO_LOG_PATH=logs/macro.log
